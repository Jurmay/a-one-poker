# ── Supabase (frontend — safe to expose, protected by RLS) ──
# Get from: https://supabase.com → Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Anthropic (SERVER-SIDE ONLY — never prefix with REACT_APP_) ──
# Used by api/coach.js (Vercel serverless function) and api/devServer.js (local dev).
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
